{
  "name": "clideck",
  "version": "2.5.0-fork.8",
  "description": "Run AI agents from different providers, let them work with you and each other, and view their work in one place",
  "main": "src/server.js",
  "bin": {
    "clideck": "bin/clideck.js"
  },
  "files": [
    "bin/",
    "src/",
    "plugin-sdk/",
    "plugins/emoji/",
    "plugins/git-diff/",
    "plugins/supertonic/",
    "plugins/smart-dictation/",
    "PLUGIN-SDK.md",
    "SESSION-BACKUP.md",
    "SESSION-ARCHIVE.md",
    "UPGRADING.md",
    "plugins/voice-input/",
    "dist/public/",
    "LOCAL-MAINTENANCE.md"
  ],
  "scripts": {
    "start": "node bin/clideck.js",
    "smoke": "node smoke.js",
    "smoke:codex": "node smoke-codex.js",
    "smoke:gemini": "node smoke-gemini.js",
    "smoke:opencode": "node smoke-opencode.js",
    "smoke:pi": "node smoke-pi.js",
    "smoke:menu": "node smoke-menu.js",
    "smoke:multi": "node smoke-multi.js",
    "smoke:ask": "node smoke-ask.js",
    "smoke:resume": "node smoke-resume.js",
    "smoke:shell": "node smoke-shell.js",
    "test": "node --test",
    "test:backend": "node --test test/*.test.js",
    "build:client": "node tools/build-client.js",
    "prepack": "npm run build:client",
    "test:browser:fork": "node test-ui/xterm-replies-browser.mjs && node test-ui/xterm-scroll-browser.mjs && node test-ui/fork-integration-browser.mjs && node test-ui/draft-integration-browser.mjs && node test-ui/snapshot-reset-browser.mjs && node test-ui/terminal-cursor-browser.mjs",
    "check:client": "node tools/check-client.js",
    "test:browser:mobile": "node test-ui/mobile-restoration-browser.mjs",
    "test:ui": "node tools/run-ui-tests.js"
  },
  "dependencies": {
    "@xterm/addon-serialize": "0.15.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/headless": "6.1.0-beta.303",
    "@xterm/xterm": "6.1.0-beta.304",
    "mermaid": "^11.16.0",
    "node-pty": "1.2.0-beta.15",
    "smol-toml": "1.9.0",
    "ws": "8.21.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Or Kuntzman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustykuntz/clideck.git"
  },
  "homepage": "https://clideck.dev/",
  "bugs": {
    "url": "https://github.com/rustykuntz/clideck/issues"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.61.1"
  },
  "clideckUpdatePolicy": "local",
  "clideckUpstreamVersion": "2.5.0"
}
